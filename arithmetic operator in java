import java.util.*;    // sum of two number a and b
public class datatype{
    public static void main(String[] args){
        Scanner Sc = new Scanner(System.in);
        int a  = Sc.nextInt();  // it is a input a
        int b = Sc.nextInt();  // it is inout b
        int sum = a+b;  // comdition

        System.out.println(sum); // it is used to print the sum of a and b

        int x = Sc.nextInt();   // it is the input x
        int y = Sc.nextInt();   // it is the input y
        int modulo = x%y;  // condition

        // multiply of x and y
        System.out.println(modulo);  //  to print a modulo of x and y

        int m = Sc.nextInt();  // it is input m
        int n = Sc.nextInt();  // it is input n
        int p  = m*n;
        System.out.println(p); // tp print a product of m and n

        int P = Sc.nextInt (); // it is a input P
        int Q = Sc.nextInt (); // it is a input Q
        int div = P/Q;  // condition
        System.out.println(div); // to print a div of P and Q


        int A = Sc.nextInt(); // it is input A 
        int B = Sc.nextInt(); // it is input B
        int sub = A - B; // condition 
        System.out.println(sub);  // to print a substraction of A and B 
    }

}
